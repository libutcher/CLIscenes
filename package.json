{
  "name": "cliscenes",
  "version": "0.1.0",
  "description": "Interactive, embeddable walkthroughs of developer workflows that move between the terminal and other applications.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "generate": "tsx scripts/generate.ts",
    "validate": "tsx scripts/generate.ts --check",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "gifs": "npm run build && tsx scripts/record-gifs.ts"
  },
  "dependencies": {
    "asciinema-player": "^3.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
